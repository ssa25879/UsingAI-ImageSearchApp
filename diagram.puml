@startuml
skinparam classAttributeIconSize 0
hide empty members

package "Core" {
  abstract class "Result<TData, TError>" as ResultT <<abstract record, immutable>> {
    -Result()
    +FromSuccess(data: TData): Result<TData, TError>
    +FromError(error: TError): Result<TData, TError>
  }

  class "Result<TData, TError>.Success" as ResultSuccess <<sealed record, immutable>> {
    ~Success(data: TData)
    +Data: TData <<get-only>>
  }

  class "Result<TData, TError>.Error" as ResultError <<sealed record, immutable>> {
    ~Error(error: TError)
    +Value: TError <<get-only>>
  }

  enum "NetworkError" as NetworkError {
    NoInternet
    NetworkTimeout
    ConnectionFailure
    BadRequest
    Unauthorized
    Forbidden
    NotFound
    RateLimited
    ServerError
    Unknown
  }

  ResultT <|-- ResultSuccess
  ResultT <|-- ResultError
}

package "Domain" {
  class "ImageItem" as ImageItem <<immutable>> {
    -_id: long
    -_thumbnailUrl: Uri
    -_aspectRatio: double
    -_sourcePageUrl: Uri
    -_tags: IReadOnlyList<string>
    +Id: long <<readonly>>
    +ThumbnailUrl: Uri <<readonly>>
    +AspectRatio: double <<readonly>>
    +SourcePageUrl: Uri <<readonly>>
    +Tags: IReadOnlyList<string> <<readonly>>
    +ImageItem(id: long, thumbnailUrl: Uri, aspectRatio: double, sourcePageUrl: Uri, tags: IReadOnlyList<string>)
  }

  interface "IImageSearchRepository" as IImageSearchRepository {
    +SearchAsync(keyword: string, page: int, pageSize: int, cancellationToken: CancellationToken): UniTask<Result<IReadOnlyList<ImageItem>, NetworkError>>
  }

  interface "IImageThumbnailRepository" as IImageThumbnailRepository {
    +LoadAsync(thumbnailUrl: Uri, cancellationToken: CancellationToken): UniTask<Result<byte[], NetworkError>>
  }
}

package "Presentation" {
  interface "ISearchScreenView" as ISearchScreenView <<view contract>> {
    +ShowSearching()
    +ShowResults(items: IReadOnlyList<ImageItem>)
    +ShowError(message: string)
    +ShowEmptyResults()
    +SetThumbnail(imageId: long, texture: Texture2D)
    +ShowThumbnailPlaceholder(imageId: long)
    +ClearResults()
  }

  class "SearchScreenPreviewController" as SearchScreenView <<MonoBehaviour, UI Toolkit>> {
    -_presenter: SearchScreenPresenter
    -_ownedTextures: Dictionary<long, Texture2D>
    +Initialize(presenter: SearchScreenPresenter)
    -OnSearchClicked()
    +ClearResults()
    +Dispose()
  }

  class "SearchScreenPresenter" as SearchScreenPresenter {
    +SearchScreenPresenter(searchRepository: IImageSearchRepository, thumbnailRepository: IImageThumbnailRepository, view: ISearchScreenView)
    -_searchRepository: IImageSearchRepository
    -_thumbnailRepository: IImageThumbnailRepository
    -_view: ISearchScreenView
    -_operationCts: CancellationTokenSource
    -_operationId: int
    +SearchAsync(keyword: string): UniTask
    +Dispose()
    +MessageFor(error: NetworkError): string
  }

  SearchScreenView ..|> ISearchScreenView
  SearchScreenView --> SearchScreenPresenter : "입력 이벤트 전달"
  SearchScreenPresenter --> ISearchScreenView : "상태 / 결과 표시"
  SearchScreenPresenter ..> IImageSearchRepository : "검색 계약만 사용"
  SearchScreenPresenter ..> IImageThumbnailRepository : "썸네일 바이트 요청"
  SearchScreenPresenter ..> ImageItem : "검색 결과 표시"
  SearchScreenPresenter ..> ResultT : "Success / Error 패턴 매칭"
  SearchScreenPresenter ..> NetworkError : "enum별 사용자 메시지"
  SearchScreenPresenter ..> UniTaskT : "비동기 호출"
  SearchScreenView ..> UnityTexture2D : "표시 및 수명 소유"
}

package "Data" {
  enum "MockSearchScenario" as MockSearchScenario {
    Success
    EmptyResults
    ConnectionFailure
    ServerError
  }

  class "MockPixabayImageSearchDataSource" as MockPixabayImageSearchDataSource <<MonoBehaviour>> {
    -_scenario: MockSearchScenario
    +Scenario: MockSearchScenario
    +SearchAsync(keyword: string, page: int, pageSize: int, cancellationToken: CancellationToken): UniTask<PixabaySearchResponseDto>
  }

  class "MockImageThumbnailRepository" as MockImageThumbnailRepository {
    +LoadAsync(thumbnailUrl: Uri, cancellationToken: CancellationToken): UniTask<Result<byte[], NetworkError>>
  }

  interface "IPixabayImageThumbnailDataSource" as IPixabayImageThumbnailDataSource {
    +LoadAsync(url: Uri, cancellationToken: CancellationToken): UniTask<byte[]>
  }

  class "PixabayImageThumbnailDataSource" as PixabayImageThumbnailDataSource {
    +LoadAsync(url: Uri, cancellationToken: CancellationToken): UniTask<byte[]>
  }

  class "PixabayImageThumbnailRepository" as PixabayImageThumbnailRepository {
    -_dataSource: IPixabayImageThumbnailDataSource
    +LoadAsync(thumbnailUrl: Uri, cancellationToken: CancellationToken): UniTask<Result<byte[], NetworkError>>
  }

  class "PixabaySearchResponseDto" as PixabaySearchResponseDto <<JSON DTO>> {
    +total: int
    +totalHits: int
    +hits: IReadOnlyList<PixabayHitDto>
  }

  class "PixabayHitDto" as PixabayHitDto <<JSON DTO>> {
    +id: long
    +pageURL: string
    +type: string
    +tags: string
    +previewURL: string
    +previewWidth: int
    +previewHeight: int
    +webformatURL: string
    +webformatWidth: int
    +webformatHeight: int
    +largeImageURL: string
    +fullHDURL: string [0..1]
    +imageURL: string [0..1]
    +imageWidth: int
    +imageHeight: int
    +imageSize: long
    +views: int
    +downloads: int
    +likes: int
    +comments: int
    +user_id: long
    +user: string
    +userImageURL: string
  }

  interface "IPixabayImageSearchDataSource" as IPixabayImageSearchDataSource {
    +SearchAsync(keyword: string, page: int, pageSize: int, cancellationToken: CancellationToken): UniTask<PixabaySearchResponseDto>
  }

  class "PixabayImageSearchDataSource" as PixabayImageSearchDataSource {
    -_apiKey: string
    -_cache: PixabaySearchCache
    -_requestWindow: PixabayRequestWindow
    +SearchAsync(keyword: string, page: int, pageSize: int, cancellationToken: CancellationToken): UniTask<PixabaySearchResponseDto>
    -BuildRequestUrl(apiKey: string, keyword: string, page: int, pageSize: int): string
    -ParseResponse(json: string): PixabaySearchResponseDto
  }

  class "PixabaySearchCache" as PixabaySearchCache {
    +TryRead(requestKey: string, utcNow: DateTime, out json: string): bool
    +Store(requestKey: string, json: string, utcNow: DateTime)
  }

  class "PixabayRequestWindow" as PixabayRequestWindow {
    +TryEnter(utcNow: DateTime): bool
  }

  class "PixabayImageSearchMapper" as PixabayImageSearchMapper {
    +ToModel(dto: PixabayHitDto): ImageItem
    +ParseTags(tags: string): IReadOnlyList<string>
  }

  class "PixabayImageSearchRepository" as PixabayImageSearchRepository {
    -_dataSource: IPixabayImageSearchDataSource
    -_mapper: PixabayImageSearchMapper
    +SearchAsync(keyword: string, page: int, pageSize: int, cancellationToken: CancellationToken): UniTask<Result<IReadOnlyList<ImageItem>, NetworkError>>
    -MapTransportFailure(failure: PixabayTransportFailure): NetworkError
    -MapHttpStatus(statusCode: long): NetworkError
  }

  enum "PixabayTransportFailure" as PixabayTransportFailure {
    NoInternet
    Timeout
    ConnectionFailure
  }

  class "PixabayNetworkException" as PixabayNetworkException <<exception>> {
    +Failure: PixabayTransportFailure
  }

  class "PixabayHttpException" as PixabayHttpException <<exception>> {
    +StatusCode: int
    +ResponseBody: string
  }

  class "PixabayResponseException" as PixabayResponseException <<exception>> {
    +Message: string
  }
}

package "Composition Root" {
  class "ImageSearchCompositionRoot" as ImageSearchCompositionRoot <<MonoBehaviour>> {
    -Awake()
  }

  class "PixabayApiKeyLoader" as PixabayApiKeyLoader <<static>> {
    +TryRead(path: string, out key: string): bool
  }
}

package "External: UniTask (Cysharp.Threading.Tasks)" {
  class "UniTask<T>" as UniTaskT <<struct>>
}

package "External: Unity" {
  class "UnityWebRequest" as UnityWebRequest
  class "Texture2D" as UnityTexture2D
}

Domain ..> ResultT : "Core 참조"
Domain ..> NetworkError : "Core 참조"
Domain ..> UniTaskT : "비동기 반환 타입"
Presentation ..> Domain : "Domain 모델 / Repository 계약"
Presentation ..> Core : "Result / NetworkError"
Presentation ..> UniTaskT : "비동기 호출"
IImageSearchRepository ..> ImageItem : "검색 결과"
IImageSearchRepository ..> ResultT : "결과와 오류를 값으로 반환"
IImageThumbnailRepository ..> ResultT : "썸네일 다운로드 결과"
IImageThumbnailRepository ..> NetworkError
IImageThumbnailRepository ..> UniTaskT

Data ..> Domain : "구현 및 Domain Model 사용"
Data ..> Core : "Result / NetworkError 사용"
Data ..> UniTaskT : "비동기 반환 타입"
PixabayImageSearchDataSource ..|> IPixabayImageSearchDataSource
MockPixabayImageSearchDataSource ..|> IPixabayImageSearchDataSource
MockPixabayImageSearchDataSource --> MockSearchScenario
PixabayImageSearchDataSource ..> UnityWebRequest : "실제 HTTP 호출"
PixabayImageThumbnailDataSource ..> UnityWebRequest : "실제 썸네일 HTTP 호출"
IPixabayImageSearchDataSource ..> PixabaySearchResponseDto : "DTO 반환"
PixabaySearchResponseDto "1" *-- "0..*" PixabayHitDto : "hits"
PixabayImageSearchRepository ..|> IImageSearchRepository
MockImageThumbnailRepository ..|> IImageThumbnailRepository
PixabayImageThumbnailRepository ..|> IImageThumbnailRepository
PixabayImageThumbnailDataSource ..|> IPixabayImageThumbnailDataSource
PixabayImageSearchRepository --> IPixabayImageSearchDataSource : "호출"
PixabayImageSearchRepository --> PixabayImageSearchMapper : "변환"
PixabayImageSearchMapper ..> PixabayHitDto : "입력 DTO"
PixabayImageSearchMapper ..> ImageItem : "Domain Model 생성"
PixabayImageSearchRepository ..> PixabayNetworkException : "예외 매핑"
PixabayImageSearchRepository ..> PixabayHttpException : "예외 매핑"
PixabayImageSearchRepository ..> PixabayResponseException : "예외 매핑"
PixabayImageSearchRepository ..> ResultT : "Success / Error 반환"
PixabayImageSearchRepository ..> NetworkError : "예외를 enum으로 매핑"
PixabayImageSearchDataSource ..> PixabayNetworkException : "던짐"
PixabayImageSearchDataSource ..> PixabayHttpException : "던짐"
PixabayImageSearchDataSource ..> PixabayResponseException : "던짐"
PixabayImageSearchDataSource --> PixabaySearchCache : "24시간 검색 응답 캐시"
PixabayImageSearchDataSource --> PixabayRequestWindow : "분당 최대 100회 제한"
PixabayImageThumbnailRepository --> IPixabayImageThumbnailDataSource : "호출"
PixabayImageThumbnailRepository ..> PixabayNetworkException : "예외 매핑"
PixabayImageThumbnailRepository ..> PixabayHttpException : "예외 매핑"
PixabayImageThumbnailRepository ..> PixabayResponseException : "예외 매핑"
PixabayImageThumbnailDataSource ..> PixabayNetworkException : "던짐"
PixabayImageThumbnailDataSource ..> PixabayHttpException : "던짐"
PixabayImageThumbnailDataSource ..> PixabayResponseException : "던짐"
ImageSearchCompositionRoot ..> MockPixabayImageSearchDataSource : "기본 / 강제 Mock"
ImageSearchCompositionRoot ..> PixabayImageSearchMapper : "생성"
ImageSearchCompositionRoot ..> PixabayImageSearchRepository : "생성"
ImageSearchCompositionRoot ..> MockImageThumbnailRepository : "Mock 썸네일 공급"
ImageSearchCompositionRoot ..> PixabayImageSearchDataSource : "Editor + 키 + Force Mock 해제 시 생성"
ImageSearchCompositionRoot ..> PixabayImageThumbnailRepository : "Editor 실 API 경로에서 생성"
ImageSearchCompositionRoot ..> PixabayImageThumbnailDataSource : "Editor 실 API 경로에서 생성"
ImageSearchCompositionRoot ..> PixabayApiKeyLoader : "UserSettings 로컬 키 조회"
ImageSearchCompositionRoot ..> SearchScreenPresenter : "Repository 인터페이스 주입"
ImageSearchCompositionRoot ..> SearchScreenView : "프리젠터 주입"
ImageSearchCompositionRoot ..> Data : "구체 구현 참조 허용"
ImageSearchCompositionRoot ..> Presentation : "화면 조립"

note right of MockImageThumbnailRepository
  Mock 구현은 네트워크 없이 PNG 바이트를 생성합니다.
  Composition Root의 기본 경로 또는 Force Mock에서 사용됩니다.
end note

note right of PixabayImageThumbnailRepository
  실제 썸네일 DataSource의 바이트 결과와 예상 가능한 네트워크 오류를
  IImageThumbnailRepository의 Result로 변환합니다.
end note

note right of SearchScreenPresenter
  검색 입력을 trim한 뒤 Domain Repository로 전달합니다.
  새 검색마다 이전 CancellationTokenSource를 취소하고 새 검색 세대를 만듭니다.
  같은 토큰으로 Repository 검색과 해당 검색 세대의 모든 썸네일 작업을 취소합니다.
  취소는 Error로 표시하지 않습니다. 화면 종료 시에도 취소하고 Dispose합니다.
  요청 세대 ID도 확인해 취소를 무시한 오래된 결과가 화면을 덮지 않게 합니다.
  Success.Data는 결과 카드로 표시하고, 항목별 썸네일 요청은 비동기로 병렬 시작합니다.
  Error.Value는 NetworkError enum별 한국어 메시지로 변환합니다.
  썸네일 실패는 검색 전체 오류로 바꾸지 않고 해당 카드의 placeholder로 표시합니다.
end note

note right of SearchScreenView
  UI Toolkit UXML의 TextField / Button 입력을 Presenter에 전달합니다.
  로딩, 결과 수, 빈 결과, 오류 메시지를 표시합니다.
  Texture2D를 카드에 연결하며 화면 세대의 텍스처 소유권을 관리합니다.
  새 검색 또는 Dispose 때 먼저 UI 참조를 제거한 다음 소유 Texture2D를 Destroy합니다.
  다운로드 취소 또는 낡은 응답에서 만들어진 텍스처도 표시하지 않고 즉시 해제합니다.
  OnDestroy에서 Presenter.Dispose()를 호출합니다.
end note

note right of ImageSearchCompositionRoot
  Scene의 Composition Root가 먼저 Mock 검색 / 썸네일 구현을 선택합니다.
  Editor에서 Force Mock이 꺼져 있고 UserSettings/ImageSearch/pixabay.key를
  읽을 수 있을 때에만 실 Pixabay 검색 및 썸네일 구현으로 바꿉니다.
  모바일 빌드는 Mock 구현만 사용합니다.
  이어 DataSource, Mapper, Repository 구현을 만들고,
  Repository 인터페이스를 Presenter 생성자에 주입합니다.
  이어 SearchScreenPreviewController를 ISearchScreenView로 전달하고 Presenter를 View.Initialize에 넣습니다.
  Presenter와 View는 PixabayImageSearchRepository 같은 구현 클래스를 참조하지 않습니다.
  API 키는 기존 보안 규칙에 따라 소스나 커밋 파일에 두지 않고 외부 로컬 설정에서 공급합니다.
end note

note right of IImageSearchRepository
  빈/공백 검색어는 요청하지 않고 빈 성공 결과를 반환합니다.
  취소는 Error로 변환하지 않고 OperationCanceledException으로 전파합니다.
  반환형에는 HasMore가 없습니다. pageSize와 결과 수로 다음 페이지를 추정하며,
  마지막 페이지가 pageSize와 같으면 빈 페이지를 한 번 더 요청할 수 있습니다.
end note

note bottom of Domain
  Domain은 UnityEngine과 API DTO에 의존하지 않습니다.
  Uri, CancellationToken, IReadOnlyList, UniTask는 외부/표준 타입입니다.
  Domain asmdef는 Core와 UniTask 어셈블리를 참조합니다.
비동기 Repository API는 UniTask를 사용합니다. UniTask 패키지는 Unity Package Manager로 설치합니다.
end note

note bottom of Data
  DTO는 Pixabay JSON 키 이름과 계층을 그대로 유지하며, hits 컬렉션은 JsonUtility 호환 List<PixabayHitDto>입니다.
  fullHDURL과 imageURL은 응답에서 생략될 수 있으므로 nullable/optional 필드로 취급합니다.
  JSON 키는 대소문자를 구분합니다. webformatURL은 24시간 유효하며 영구 핫링크 용도로 쓰지 않습니다.
  API 키는 DTO나 소스 코드에 상수로 두지 않습니다. Editor에서는 UserSettings의 로컬 키 파일에서 읽습니다.
end note

note right of IPixabayImageSearchDataSource
  실제 HTTP 구현은 UnityWebRequest를 사용합니다.
  던질 수 있는 예외: PixabayNetworkException, PixabayHttpException,
  PixabayResponseException, OperationCanceledException.
  Data asmdef는 UniTask 반환형을 사용하기 위해 Cysharp.Threading.Tasks를 직접 참조합니다.
  취소 예외는 그대로 전파합니다.
end note

note right of PixabayImageSearchMapper
  tags가 null/빈 문자열이면 빈 목록을 반환합니다.
  쉼표(,)로 분리한 뒤 각 항목의 앞뒤 공백을 제거하고,
  빈 항목을 버리며 입력 순서와 대소문자를 유지합니다.
  예: "a, b, c" → ["a", "b", "c"]
  webformatURL → ThumbnailUrl,
  webformatWidth / webformatHeight → AspectRatio,
  pageURL → SourcePageUrl.
end note

note right of PixabayImageSearchRepository
  성공 DTO의 hits를 Mapper로 ImageItem 목록으로 변환해 Success로 반환합니다.
  NoInternet/Timeout/ConnectionFailure → NetworkError.NoInternet/NetworkTimeout/ConnectionFailure.
  HTTP 400/401/403/404/429/5xx → BadRequest/Unauthorized/Forbidden/
  NotFound/RateLimited/ServerError로 변환합니다.
  응답 형식 오류와 분류 불가 외부 오류는 Unknown으로 변환합니다.
  OperationCanceledException은 Error로 바꾸지 않고 다시 던집니다.
  예상하지 못한 프로그래밍 오류는 NetworkError로 숨기지 않습니다.
end note

note bottom of Data
  계층 의존 방향은 Data → Domain/Core, Domain → Core입니다.
  Domain → Data 및 Core → 상위 레이어 참조는 없습니다.
  IReadOnlyList 반환형은 HasMore를 포함하지 않습니다.
  Pixabay totalHits를 포함한 페이지 메타데이터는 현재 Domain 계약에 전달되지 않습니다.
end note

note right of NetworkError
  결과가 없는 검색은 빈 목록을 담은 Success입니다.
  NotFound는 HTTP 404 등 요청 대상 오류를 뜻하며 빈 결과와 구분합니다.
  Unknown은 분류되지 않은 외부 오류에만 사용하고,
  취소와 프로그래밍 오류는 이 enum으로 변환하지 않습니다.
end note

note right of ResultT
  성공은 Success(data), 실패는 Error(error)로 표현합니다.
  Success와 Error는 이 추상 record의 중첩 sealed record입니다.
  생성자는 internal이며 FromSuccess / FromError가 인스턴스를 생성합니다.
  TError는 NetworkError enum입니다.
  제네릭 선언 자체는 TError가 enum인지 제한하지 않으며,
  Repository 사용 계약에서 NetworkError로 구체화합니다.
  Result 래퍼는 불변이며, 컬렉션 자체의 불변성은 호출부가 보장해야 합니다.
end note
@enduml

@startuml SearchScreenSearchFlow
title 검색 화면 흐름과 요청 / 썸네일 취소
autonumber

actor User as User
participant "SearchScreenView\n(UI Toolkit)" as View
participant SearchScreenPresenter as Presenter
participant IImageSearchRepository as SearchRepo
participant IImageThumbnailRepository as ThumbnailRepo

User -> View : 검색어 입력 후 검색 버튼
alt keyword가 비어 있음
  View -> View : 아무 작업 없이 종료
else keyword가 있음
View -> Presenter : SearchAsync(keyword)
Presenter -> Presenter : 이전 세대 취소
Presenter -> Presenter : 새 CTS + operationId 생성
Presenter -> View : ShowSearching()
Presenter -> View : ClearResults()
View -> View : 카드 참조 제거 후 소유 Texture2D Destroy
Presenter -> SearchRepo : SearchAsync(keyword, 1, pageSize, token)
SearchRepo --> Presenter : UniTask<Result<IReadOnlyList<ImageItem>, NetworkError>>

alt Success(data)
  alt data가 비어 있음
    Presenter -> View : ShowEmptyResults()
  else 결과 있음
    Presenter -> View : ShowResults(data)
    loop 각 ImageItem에 대해 비동기 작업 시작
      Presenter ->> ThumbnailRepo : LoadAsync(ThumbnailUrl, token)
      ThumbnailRepo -->> Presenter : Result<byte[], NetworkError>
      alt 썸네일 성공 + 현재 operationId
        Presenter -> Presenter : 메인 스레드에서 Texture2D 생성
        Presenter -> View : SetThumbnail(imageId, texture)
      else 썸네일 오류
        Presenter -> View : ShowThumbnailPlaceholder(imageId)
      else 이전 세대 / 취소됨
        Presenter -> Presenter : 결과 무시, 생성된 Texture2D 해제
      end
    end
  end
else Error(error)
  Presenter -> Presenter : NetworkError별 한국어 메시지 선택
  Presenter -> View : ShowError(message)
else 검색 취소
  Presenter -> Presenter : OperationCanceledException을 catch하고 종료
end
end

note over Presenter, View
  NetworkError 메시지 매핑:
  NoInternet → 인터넷 연결을 확인해 주세요.
  NetworkTimeout → 요청 시간이 초과됐습니다. 다시 시도해 주세요.
  ConnectionFailure → 서버에 연결하지 못했습니다.
  BadRequest → 검색 요청이 올바르지 않습니다.
  Unauthorized → 검색 인증에 실패했습니다.
  Forbidden → 검색 권한이 없습니다.
  NotFound → 요청한 리소스를 찾지 못했습니다.
  RateLimited → 요청이 많습니다. 잠시 후 다시 시도해 주세요.
  ServerError → 검색 서버에 문제가 발생했습니다.
  Unknown → 알 수 없는 오류가 발생했습니다.
  현재 구현은 SearchAsync / LoadThumbnailAsync에서 취소 예외를 catch 후 삼킵니다.
  이는 AGENTS.md의 취소 예외 전파 규칙과 불일치합니다.
end note

note over View, ThumbnailRepo
  새 검색 또는 화면 종료 시 세대 token이 검색/썸네일 요청을 함께 취소합니다.
  View는 Image 참조를 먼저 제거하고 소유 Texture2D를 Destroy합니다.
end note
@enduml
